# Écoute locale par défaut. Pour le LAN, utilisez l’adresse IP du serveur.
BIND_ADDRESS=127.0.0.1
GAME_SERVER_IP=127.0.0.1

GAME_SERVER_VERSION=1.41.9
GAME_SERVER_ID=601
# Généré automatiquement par offline-common.sh lors du premier lancement.
GAME_SERVER_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
GAME_SERVER_NAME=StarLoco

# Identifiant du back-office. Le mot de passe est généré séparément dans
# runtime/stack/secrets/admin_password.secret.
ADMIN_USERNAME=admin

RATE_XP=1
RATE_DROP=1
RATE_DROP_THRESHOLD=1
RATE_KAMAS=1
RATE_JOB=1
RATE_FM=1
RATE_HONOR=1
GAME_SERVER_DEBUG=false

# Fil communautaire : fréquence et seuils des objets affichés.
SOCIAL_SCAN_INTERVAL=15
SOCIAL_ITEM_MIN_LEVEL=60
SOCIAL_ITEM_MIN_PRICE=50000
SOCIAL_ITEM_MIN_POINTS=1
SOCIAL_RETENTION_DAYS=90
SOCIAL_MAX_EVENTS=5000
